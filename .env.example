# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# EMAIL NOTIFICATION SERVICE (Real Order Notifications to alhajabizventure@gmail.com)
# Option 1: Resend (https://resend.com)
RESEND_API_KEY=
RESEND_FROM_EMAIL=orders@ridhalventures.com

# Option 2: SendGrid (https://sendgrid.com)
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=orders@ridhalventures.com

# Option 3: Standard SMTP (Gmail App Password, Brevo, Mailgun, cPanel)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=orders@ridhalventures.com

# NIGERIAN PAYMENT GATEWAYS (Optional - Paystack & Flutterwave)
# Configure these to enable automated online debit card, USSD, and instant bank transfers
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
FLUTTERWAVE_SECRET_KEY=

